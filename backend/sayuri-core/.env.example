SAYURI_ENVIRONMENT=development
SAYURI_HOST=127.0.0.1
SAYURI_PORT=8765
SAYURI_DATA_DIR=./data
SAYURI_ENABLE_LOGIC=true
SAYURI_ENABLE_EVOLUTION=true
SAYURI_ENABLE_LEARNING=true

# Frontend origins allowed to call local Sayuri Core.
SAYURI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Safe default for development/CI. No external request is made.
SAYURI_LLM_PROVIDER=mock

# To connect an OpenAI-compatible provider:
# SAYURI_LLM_PROVIDER=openai-compatible
# SAYURI_LLM_BASE_URL=https://provider.example/v1
# SAYURI_LLM_MODEL=your-model-id
# SAYURI_LLM_API_KEY=replace-locally
# SAYURI_LLM_TIMEOUT_SECONDS=60
# SAYURI_LLM_TEMPERATURE=0.2

# MCP catalog metadata only in v0.2. Arbitrary MCP command execution is disabled.
# Example:
# SAYURI_MCP_SERVERS_JSON=[{"name":"github","transport":"remote","description":"GitHub tools","enabled":false}]
SAYURI_MCP_SERVERS_JSON=[]
